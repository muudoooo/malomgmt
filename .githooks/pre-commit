#!/bin/zsh
# MALO · comprobacion de sintaxis antes de cada commit
#
# Por que existe: todo el JavaScript de la app va dentro de index.html. Una
# llave suelta no da error en ningun sitio hasta que el navegador carga la
# pagina, y entonces NO SE EJECUTA NADA: la app se queda en "Conectando...".
# Ya paso una vez, en produccion.
#
# Este hook saca el <script> de index.html y se lo da a JavaScriptCore (el
# motor de Safari, que viene con macOS) para que lo parsee. Si no compila,
# el commit no sale. Tarda menos de un segundo. No hace falta instalar node.
#
# Instalar:  git config core.hooksPath .githooks
# Saltarselo una vez (solo si sabes lo que haces):  git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

[ -f index.html ] || exit 0

TMP=$(mktemp -t malo-check).js

python3 - "$TMP" <<'PY'
import re, sys
h = open("index.html", encoding="utf-8").read()
bloques = re.findall(r'<script(?![^>]*\bsrc=)[^>]*>(.*?)</script>', h, re.S)
if not bloques:
    sys.stderr.write("pre-commit: no se encontro ningun <script> en index.html\n")
    sys.exit(1)
open(sys.argv[1], "w", encoding="utf-8").write("\n".join(bloques))
PY

CHECK=$(mktemp -t malo-runner).js
cat > "$CHECK" <<EOF
ObjC.import('Foundation');
var s = \$.NSString.stringWithContentsOfFileEncodingError('$TMP', \$.NSUTF8StringEncoding, null).js;
try { new Function(s); console.log('OK'); }
catch (e) { console.log('FALLO: ' + e.message); }
EOF

# 2>&1 no es decorativo: en JXA console.log escribe por stderr, no por stdout.
# Sin esto RES sale siempre vacio y el hook bloquea hasta los commits buenos.
RES=$(osascript -l JavaScript "$CHECK" 2>&1)
rm -f "$TMP" "$CHECK"

if [ "$RES" != "OK" ]; then
  echo ""
  echo "  X  index.html NO COMPILA - commit cancelado"
  echo "     $RES"
  echo ""
  echo "     Si esto sube a produccion, la app se queda en 'Conectando...'"
  echo "     y no se ejecuta nada de JavaScript."
  echo ""
  exit 1
fi

echo "  OK  index.html compila"

# ── Prueba de humo: ejecutar, no solo compilar ───────────────────────────────
# Compilar no basta. Han pasado a produccion dos fallos que compilaban bien y
# reventaban al ejecutarse (pestañas de Editorial en v0.030, seccion Merch en
# v0.039). Esto pinta cada vista con un DOM y una BD falsos.
if [ -x herramientas/humo.sh ]; then
  if ! herramientas/humo.sh; then
    echo ""
    echo "  X  alguna vista revienta al ejecutarse - commit cancelado"
    echo "     Compila, pero el usuario veria la seccion en blanco."
    echo ""
    exit 1
  fi
fi

# ── Freno de mano: borrados masivos ──────────────────────────────────────────
#
# Por que existe: el 27 ago 2026 dos commits distintos se escribieron a partir
# de una copia vieja de index.html y revirtieron, sin un solo conflicto, dias de
# trabajo (las entradas y el line-up de produccion, y despues el historial de
# Novedades). Git no avisa: para el es un cambio legitimo.
#
# La firma es siempre la misma: un commit que quita muchisimas lineas mientras
# dice estar anadiendo una cosa pequena. Esto lo corta y obliga a mirar.
#
# Saltarselo cuando el borrado SI es intencionado (una limpieza de codigo
# muerto, por ejemplo):  git commit --no-verify
#   o:  MALO_BORRADO_OK=1 git commit ...

LIMITE=${MALO_LIMITE_BORRADO:-80}

if [ -n "$MALO_BORRADO_OK" ]; then
  echo "  ..  aviso de borrado masivo desactivado a mano"
  exit 0
fi

# Solo si index.html ya existia en HEAD (en el primer commit no hay con que comparar)
if git cat-file -e HEAD:index.html 2>/dev/null; then
  QUITADAS=$(git diff --cached --numstat -- index.html | awk '{print $2}')
  PUESTAS=$(git diff --cached --numstat -- index.html | awk '{print $1}')
  QUITADAS=${QUITADAS:-0}
  PUESTAS=${PUESTAS:-0}
  NETO=$((QUITADAS - PUESTAS))
  if [ "$NETO" -gt "$LIMITE" ]; then
    echo ""
    echo "  X  index.html PIERDE $NETO lineas netas - commit cancelado"
    echo "     (quita $QUITADAS, anade $PUESTAS; el limite son $LIMITE)"
    echo ""
    echo "     Esto es exactamente lo que pasa cuando se reescribe el archivo"
    echo "     entero a partir de una copia anterior: se borra el trabajo de"
    echo "     otra sesion y git lo acepta como si fuera un cambio normal."
    echo ""
    echo "     Antes de insistir, comprueba que no te estas dejando nada:"
    echo "       git diff --cached index.html | grep '^-' | less"
    echo ""
    echo "     Si el borrado es a proposito:"
    echo "       MALO_BORRADO_OK=1 git commit ..."
    echo ""
    exit 1
  fi
fi

exit 0
