# Cabeceras de seguridad servidas por Netlify para toda la app.
# (Netlify lee este archivo en la raíz del sitio publicado.)
/*
  # Nadie puede meter MALO dentro de un <iframe>: corta el clickjacking
  # (una web que te superpone botones invisibles sobre los tuyos).
  X-Frame-Options: DENY
  # El navegador respeta el Content-Type declarado y no "adivina" que un
  # archivo subido es HTML/JS ejecutable.
  X-Content-Type-Options: nosniff
  # No filtrar la URL completa (que puede llevar ids) a terceros al salir.
  Referrer-Policy: strict-origin-when-cross-origin
  # Apaga APIs del navegador que la app no usa, por si acaso.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # Fuerza HTTPS un año (Netlify ya lo manda; se fija aquí explícito).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # ── CSP (Content-Security-Policy) EN MODO BLOQUEO ──
  # Última red contra un XSS: limita desde qué orígenes carga la app scripts,
  # estilos, imágenes y conexiones. Validada primero en modo report-only contra
  # el Supabase/Google reales (cero violaciones en arranque, datos, realtime,
  # fuentes y librerías de Drive/Calendar) antes de activar el bloqueo.
  # script-src va ajustado (jsdelivr + Google + gstatic + inline) — que es lo que
  # de verdad frena un XSS; los dominios de Google para marcos e imágenes se
  # dejan algo más anchos para no romper el selector de archivos de Drive.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://apis.google.com https://accounts.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.google.com https://*.googleusercontent.com https://*.gstatic.com; media-src blob: https://drive.google.com https://*.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://accounts.google.com https://apis.google.com; frame-src https://*.google.com https://accounts.google.com https://content.googleapis.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'
